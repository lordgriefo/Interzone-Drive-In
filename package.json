{
  "name": "strangelet-kineto-cut",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Audio-reactive kinetic montage engine and vintage cinema synthesizer",
  "author": "Interzone Drive-In",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "electron electron/main.cjs --dev",
    "electron:start": "electron electron/main.cjs",
    "build:electron": "vite build && electron electron/main.cjs --prod",
    "package:exe": "vite build && electron-builder --win",
    "package:portable": "vite build && electron-builder --win portable",
    "package:zip": "vite build && electron-builder --win zip",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "ffmpeg-static": "^5.3.0",
    "gsap": "^3.15.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.344.0",
    "meyda": "^5.6.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-powerglitch": "^1.1.0",
    "three": "^0.185.1",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/cli": "^2.2.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "electron": "^44.3.0",
    "electron-builder": "^24.13.3",
    "ffmpeg": "^1.1.3",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.6"
  },
  "build": {
    "appId": "com.strangelet.kinetocut",
    "productName": "Strangelet Kineto-Cut",
    "executableName": "Strangelet-Kineto-Cut",
    "copyright": "Copyright © 2026 Interzone Drive-In",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "target": [
        "nsis",
        "portable",
        "zip"
      ],
      "sign": null,
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Strangelet Kineto-Cut",
      "uninstallDisplayName": "Strangelet Kineto-Cut",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "guid": "d38402c8-89c2-4682-a728-kinetocut2026"
    }
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "ffmpeg-static@5.3.0": true,
    "protobufjs@6.11.6": true,
    "sharp@0.32.6": true
  }
}
