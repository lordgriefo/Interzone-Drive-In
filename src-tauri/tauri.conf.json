{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Strangelet KenetiCut",
  "version": "1.0.0",
  "identifier": "com.strangelet.kinetocut",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "The Strangelet KenetiCut",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../build/icon.ico"
    ],
    "resources": [
      "../node_modules/ffmpeg-static/ffmpeg.exe"
    ]
  }
}
